# =============================================================================
# Exponential — self-host environment
# =============================================================================
#
# Everything a self-host install (your own Railway project or Docker host)
# needs, and nothing it doesn't. The full developer file is .env.example.
#
# Build once, then start with the self-host command, which applies pending
# database migrations before serving:
#
#   npm install
#   SKIP_ENV_VALIDATION=1 npm run build
#   npm run start:selfhost
#
# Copy this file to .env: `next build`, `start:selfhost` and `next start` all
# read it. Neither the build nor the app needs an LLM key (see "AI" below).
#
# Leave NEXT_PUBLIC_APP_URL unset when you build: Next inlines NEXT_PUBLIC_*
# values at build time, and the app resolves its public URL at runtime from
# NEXTAUTH_URL instead.
#
# OPEN SIGN-UP: anyone who can reach your install and complete a sign-in (an
# OAuth provider or an emailed sign-in code) gets an account and a Personal
# workspace, exactly as on exponential.im. There is no sign-up allowlist yet,
# so keep a private install off the public internet, or don't configure a way
# in that strangers can use.

# =============================================================================
# REQUIRED — the app refuses to start without these
# =============================================================================

# Postgres 16 with the pgvector extension (0.5.0 or newer), e.g. the
# pgvector/pgvector:pg16 image. A stock postgres image will not work: startup
# stops with a message naming pgvector.
DATABASE_URL="postgresql://exponential:password@localhost:5432/exponential"

# Signs session cookies and the tokens the app and Mastra exchange.
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts stored integration credentials. 32 bytes, raw or base64.
# Generate: openssl rand -base64 32
DATABASE_ENCRYPTION_KEY=""

# =============================================================================
# RECOMMENDED
# =============================================================================

# The URL people use to reach this install, without a trailing slash. Links in
# email, OAuth callbacks and agent callbacks are built from it. Without it the
# app assumes http://localhost:${PORT}.
NEXTAUTH_URL="http://localhost:3000"

# Bearer secret for the scheduled jobs. The self-host scheduler
# (npm run scheduler:selfhost) sends it; the cron routes reject calls without it.
# Generate: openssl rand -base64 32
CRON_SECRET=""

# -----------------------------------------------------------------------------
# A way to sign in — set at least ONE of these. With none, /signin shows a setup
# error naming these variables instead of a form that can never work.
# -----------------------------------------------------------------------------

# (a) Email sign-in codes over any SMTP server. SMTP_HOST counts only together
#     with a sender. Port defaults to 587 (STARTTLS); SMTP_SECURE="true" (or "1") means
#     implicit TLS, which is the default on port 465.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_SECURE="false"
# EMAIL_FROM="Exponential <exponential@example.com>"

# (b) Email sign-in codes over Postmark (wins over SMTP when both are set).
#     The sender is EMAIL_FROM, then AUTH_POSTMARK_FROM.
# AUTH_POSTMARK_KEY=""
# AUTH_POSTMARK_FROM=""

# (c) An OAuth provider — see "Sign in with Google / Discord" below.

# (d) Single-user installs only: write each sign-in code to the server log
#     instead of emailing it. Off unless set to "true" (or "1"), and ignored
#     when SMTP or Postmark is configured. ANYONE WHO CAN READ THE SERVER LOG
#     CAN SIGN IN AS ANYONE — the app warns about this at every start. Switch
#     to SMTP or Postmark as soon as you can.
# AUTH_LOG_SIGN_IN_CODES="true"

# =============================================================================
# AI — optional. With none of these the app is a plain project and task tool:
# each AI feature is hidden or says how to turn it on, and AI jobs skip. Set
# one and restart to turn its features on; `start:selfhost` lists what is on.
# =============================================================================

# Meeting summaries, action/decision/feature extraction, semantic search and
# knowledge indexing (embeddings), digests and weekly narratives, AI workflow
# steps, ticket size suggestions.
# OPENAI_API_KEY=""

# Meeting summaries (preferred over OpenAI), Claude-written workspace updates,
# YouTube articles (with SUPADATA_API_KEY). The Mastra service needs its own.
# ANTHROPIC_API_KEY=""

# The Assistant: chat, Assign to Assistant (agent runs), scheduling
# suggestions, CRM enrichment; with OPENAI_API_KEY, voice. The URL of your
# Mastra agent service. Unset means no Assistant (not localhost).
# MASTRA_API_URL="http://localhost:4111"

# =============================================================================
# OPTIONAL — each one turns on a feature; leave unset to go without it
# =============================================================================

# Sign in with Google (also needed for Google Calendar sync).
# Callback URL: ${NEXTAUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Sign in with Discord. Callback URL: ${NEXTAUTH_URL}/api/auth/callback/discord
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# Notion (connect a Notion workspace). Registered only when both are set.
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# NOTION_REDIRECT_URI=""

# Microsoft Entra ID sign-in (currently switched off in code; these are read
# only once it is re-enabled).
# MICROSOFT_ENTRA_ID_CLIENT_ID=""
# MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
# MICROSOFT_ENTRA_ID_TENANT_ID=""

# Web push notifications. Generate a pair: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Shared rate limiting across several app instances (Upstash Redis). Without
# it, limits are per instance, which is fine for a single container.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Sentry error reporting for this install.
# NEXT_PUBLIC_SENTRY_DSN=""

# Slack app (post updates and notifications to Slack).
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""

# GitHub App (issue sync).
# GITHUB_APP_ID=""
# GITHUB_PRIVATE_KEY=""
# GITHUB_APP_SLUG=""
# GITHUB_WEBHOOK_SECRET=""

# Jev model-tier routing for chat (falls back to heuristics when unset).
# OPENROUTER_API_KEY=""

# Support address shown on the sign-in pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=""

# Server port for `npm run start:selfhost` (next start). Default: 3000
# PORT="3000"
